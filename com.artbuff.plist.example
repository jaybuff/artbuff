<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.artbuff</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jaybuff/code/artbuff/.venv/bin/python</string>
    <string>/Users/jaybuff/code/artbuff/app.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/jaybuff/code/artbuff</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/jaybuff/code/artbuff/data/artbuff.log</string>
