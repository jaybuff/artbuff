# Samsung Frame TV
TV_IP=192.168.1.50
TV_PORT=8002
TV_TOKEN_FILE=data/tv-token.txt

# Web server
HOST=0.0.0.0
PORT=8420

# Letterbox background: any color Pillow understands (black, #f5f1e8, ...)
LETTERBOX_COLOR=black

# How many ArtBuff uploads to keep on the TV before deleting the oldest
MAX_TV_UPLOADS=20

# Max requests/second to the Met (hard-capped at their limit of 80)
MET_MAX_RPS=10
LOG_FILE=data/artbuff.log

# Background warmer: prefetch this many pages ahead of where you are (0 = off), ~1 request per interval
WARM_PAGES=2
WARM_INTERVAL=1.0

# Local cache of museum data/images (LRU-evicted past these sizes)
CACHE_DIR=data/cache
CACHE_THUMBS_MB=1024
CACHE_FULL_MB=2048

# Images sent to /api/send-image. The only copies, never evicted
UPLOADS_DIR=data/uploads
